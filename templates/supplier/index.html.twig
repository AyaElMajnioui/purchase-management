{% extends 'base.html.twig' %}

{% block title %}Supplier Management
{% endblock %}

{% block body %}
    <div class="card card-outline card-success shadow">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-truck mr-2"></i>Supplier List
            </h3>
            <div class="card-tools">
                <a href="{{ path('app_supplier_new') }}" class="btn btn-success btn-sm">
                    <i class="fas fa-plus-circle"></i>
                    New Supplier
                </a>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table table-striped table-hover m-0">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 30%">Name / Company</th>
                        <th style="width: 30%">Email</th>
                        <th style="width: 20%">Phone</th>
                        <th style="width: 20%" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for supplier in suppliers %}
                        <tr>
                            <td class="font-weight-bold">{{ supplier.name }}</td>
                            <td>
                                <a href="mailto:{{ supplier.email }}" class="text-primary">
                                    <i class="fas fa-envelope mr-1"></i>
                                    {{ supplier.email }}
                                </a>
                            </td>
                            <td>
                                {% if supplier.phone %}
                                    <span class="badge badge-light border">
                                        <i class="fas fa-phone mr-1"></i>
                                        {{ supplier.phone }}
                                    </span>
                                {% else %}
                                    <span class="text-muted small">Not provided</span>
                                {% endif %}
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a href="{{ path('app_supplier_show', {id: supplier.id}) }}" class="btn btn-default btn-sm" title="Details">
                                        <i class="fas fa-eye text-info"></i>
                                    </a>
                                    <a href="{{ path('app_supplier_edit', {id: supplier.id}) }}" class="btn btn-default btn-sm" title="Edit">
                                        <i class="fas fa-edit text-warning"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                <i class="fas fa-address-book fa-2x mb-2"></i><br>
                                No suppliers in the database.
                            </td>
                        </tr>
                    {% endfor %}
                    {{ knp_pagination_render(suppliers) }}
                </tbody>
            </table>
        </div>
        <div class="card-footer clearfix">
            <span class="text-muted">Total:
                {{ suppliers|length }}
                supplier(s)</span>
        </div>
    </div>
{% endblock %}

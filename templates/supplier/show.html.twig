{% extends 'base.html.twig' %}

{% block title %}Supplier Details{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            {# Use card-success style for suppliers (consistent with index) #}
            <div class="card card-outline card-success shadow-sm">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-truck mr-2 text-success"></i>
                        Supplier Record: <strong>{{ supplier.name }}</strong>
                    </h3>
                    <div class="card-tools">
                        <span class="badge badge-success">ID: #{{ supplier.id }}</span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">
                            <i class="fas fa-envelope mr-1"></i> Email:
                        </div>
                        <div class="col-sm-8">
                            <a href="mailto:{{ supplier.email }}">{{ supplier.email }}</a>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">
                            <i class="fas fa-phone mr-1"></i> Phone:
                        </div>
                        <div class="col-sm-8 text-dark">
                            {{ supplier.phone|default('Not provided') }}
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">
                            <i class="fas fa-map-marker-alt mr-1"></i> Address:
                        </div>
                        <div class="col-sm-8 text-dark">
                            {{ supplier.address|default('No address provided')|nl2br }}
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        {# Back button on the left #}
                        <a href="{{ path('app_supplier_index') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left mr-1"></i> Back to list
                        </a>

                        {# Edit and delete buttons on the right #}
                        <div class="btn-group">
                            <a href="{{ path('app_supplier_edit', {'id': supplier.id}) }}" class="btn btn-warning btn-sm mr-2">
                                <i class="fas fa-edit mr-1"></i> Edit
                            </a>
                            {{ include('supplier/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Quick info sidebar on the right #}
        <div class="col-md-4">
            <div class="small-box bg-light border shadow-sm">
                <div class="inner">
                    <h3>{{ supplier.products|length|default(0) }}</h3>
                    <p>Associated Products</p>
                </div>
                <div class="icon">
                    <i class="fas fa-boxes text-muted"></i>
                </div>
                <a href="{{ path('app_product_index') }}" class="small-box-footer">
                    View Products <i class="fas fa-arrow-circle-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

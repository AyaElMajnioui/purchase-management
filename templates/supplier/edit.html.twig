{% extends 'base.html.twig' %}

{% block title %}Edit Supplier{% endblock %}

{% block body %}
    <div class="card card-outline card-warning shadow-sm">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-edit mr-2 text-warning"></i>
                Edit Supplier: <span class="text-muted">{{ supplier.name }}</span>
            </h3>
            <div class="card-tools">
                <span class="badge badge-warning">ID: #{{ supplier.id }}</span>
            </div>
        </div>

        <div class="card-body">
            {# Pass 'button_label' to customize the button text in _form.html.twig #}
            {{ include('supplier/_form.html.twig', {'button_label': 'Update'}) }}
        </div>

        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between align-items-center">
                {# Back button on the left #}
                <a href="{{ path('app_supplier_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to list
                </a>

                {# Delete button on the right #}
                <div>
                    {{ include('supplier/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Product Details{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-8">
            <div class="card card-outline card-info shadow-sm">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-info-circle mr-2 text-info"></i>
                        Product Information
                    </h3>
                    <div class="card-tools">
                        <span class="badge badge-secondary">ID: #{{ product.id }}</span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Product Name:</div>
                        <div class="col-sm-8 text-dark">{{ product.name }}</div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Unit Price:</div>
                        <div class="col-sm-8">
                            <span class="h4 text-success font-weight-bold">
                                {{ product.price|number_format(2, ',', ' ') }} €
                            </span>
                        </div>
                    </div>

                    <hr>

                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Description:</div>
                        <div class="col-sm-8">
                            <p class="text-justify italic">
                                {{ product.description|default('No description provided.') }}
                            </p>
                        </div>
                    </div>

                    <hr>

                    {# Display supplier if the relation exists #}
                    <div class="row mb-3">
                        <div class="col-sm-4 text-muted font-weight-bold">Supplier:</div>
                        <div class="col-sm-8">
                            <span class="badge badge-light border px-3 py-2">
                                <i class="fas fa-truck mr-1 text-primary"></i>
                                {{ product.supplier.name|default('Not assigned') }}
                            </span>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('app_product_index') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left mr-1"></i> Back to list
                        </a>

                        <div class="btn-group">
                            <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit mr-1"></i> Edit
                            </a>
                            {# Delete form is usually a standalone button #}
                            {{ include('product/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Page sidebar (optional) #}
        <div class="col-md-4">
            <div class="info-box shadow-sm">
                <span class="info-box-icon bg-info"><i class="fas fa-boxes"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Availability</span>
                    <span class="info-box-number text-success">In Stock</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

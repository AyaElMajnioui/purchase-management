{{ form_start(form) }}
    <div class="row">
        {# Product name on half width #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_row(form.name, {
                    'label': 'Product Name',
                    'attr': {'class': 'form-control', 'placeholder': 'Enter the product name...'}
                }) }}
            </div>
        </div>

        {# Price on the other half #}
        <div class="col-md-6">
            <div class="form-group">
                {{ form_row(form.price, {
                    'label': 'Selling Price (€)',
                    'attr': {'class': 'form-control', 'placeholder': 'Enter the price...'}
                }) }}
            </div>
        </div>
    </div>

    <div class="form-group">
        {{ form_row(form.description, {
            'label': 'Description',
            'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Enter the description...'}
        }) }}
    </div>

    <div class="form-group">
        {{ form_row(form.supplier, {
            'label': 'Associated Supplier',
            'attr': {'class': 'form-control select2', 'placeholder': 'Select a supplier'}
        }) }}
    </div>

    <div class="mt-4">
        <button class="btn btn-success shadow-sm">
            <i class="fas fa-save"></i> {{ button_label|default('Save Product') }}
        </button>
    </div>
{{ form_end(form) }}

{% extends 'base.html.twig' %}

{% block title %}Edit Product{% endblock %}

{% block body %}
    <div class="card card-outline card-warning shadow-sm">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-edit mr-2 text-warning"></i>
                Editing: <span class="text-muted">{{ product.name }}</span>
            </h3>
            <div class="card-tools">
                <span class="badge badge-warning">ID: #{{ product.id }}</span>
            </div>
        </div>

        <div class="card-body">
            {# The form already includes the green styled "Save" button #}
            {{ include('product/_form.html.twig') }}
        </div>

        <div class="card-footer bg-white">
            <div class="d-flex justify-content-between align-items-center">
                {# Back button on the left #}
                <a href="{{ path('app_product_index') }}" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-arrow-left mr-1"></i> Back to list
                </a>

                {# Delete button on the right to avoid accidental clicks #}
                <div>
                    {{ include('product/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

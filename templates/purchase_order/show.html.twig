{% extends 'base.html.twig' %}

{% block title %}Purchase Order #{{ purchaseOrder.orderNumber }}
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="row mb-3">
			<div class="col-sm-6">
				<h3>
					<i class="fas fa-file-invoice mr-2"></i>Purchase Order Details</h3>
			</div>
			<div class="col-sm-6 text-right">
				<a href="{{ path('app_purchase_order_index') }}" class="btn btn-outline-secondary btn-sm">
					<i class="fas fa-arrow-left mr-1"></i>
					Back to List
				</a>
				<a href="{{ path('app_purchase_order_pdf', {id: purchaseOrder.id}) }}" class="btn btn-danger btn-sm ml-2" target="_blank">
					<i class="fas fa-file-pdf mr-1"></i>
					Generate PDF
				</a>
			</div>
		</div>

		<div class="row">
			<div class="col-md-4">
				<div class="card card-primary card-outline shadow-sm">
					<div class="card-header">
						<h3 class="card-title font-weight-bold">Order Information</h3>
					</div>
					<div class="card-body p-0">
						<table class="table mb-0">
							<tr>
								<th style="width: 50%">Number:</th>
								<td class="text-primary font-weight-bold">{{ purchaseOrder.orderNumber }}</td>
							</tr>
							<tr>
								<th>Date:</th>
								<td>{{ purchaseOrder.createdAt|date('d/m/Y') }}</td>
							</tr>
							<tr>
								<th>Status:</th>
								<td>
									{# On vérifie purchaseOrder.status OU le statut de la requête originale en secours #}
									{% set currentStatus = purchaseOrder.status ?: purchaseOrder.purchaseRequest.status %}

									{% if currentStatus in ['En attente', 'Pending'] %}
										<span class="badge badge-warning">
											<i class="fas fa-clock mr-1"></i>
											Pending
										</span>
									{% elseif currentStatus in ['Validée', 'Approved', 'Approuvée'] %}
										<span class="badge badge-success">
											<i class="fas fa-check-circle mr-1"></i>
											Approved
										</span>
									{% else %}
										<span class="badge badge-secondary">
											{{ currentStatus|default('N/A') }}
										</span>
									{% endif %}
								</td>
							</tr>
							<tr>
								<th>Total:</th>
								<td class="h5 text-success font-weight-bold">
									{{ purchaseOrder.totalAmount|number_format(2, ',', ' ') }}
									€
								</td>
							</tr>
						</table>
					</div>
				</div>
			</div>

			<div class="col-md-8">
				<div class="card shadow-sm">
					<div class="card-header bg-light">
						<h3 class="card-title font-weight-bold">Product & Original Request</h3>
					</div>
					<div class="card-body">
						<div class="row mt-2">
							<div class="col-sm-6">
								<label class="text-muted mb-0">Product</label>
								<p class="lead font-weight-bold text-dark">
									{{ purchaseOrder.purchaseRequest.product.name }}
								</p>
							</div>
							<div class="col-sm-3 text-center border-left">
								<label class="text-muted mb-0">Quantity</label>
								<p class="h4">{{ purchaseOrder.purchaseRequest.quantity }}</p>
							</div>
							<div class="col-sm-3 text-center border-left">
								<label class="text-muted mb-0">Unit Price</label>
								<p class="h4">{{ purchaseOrder.purchaseRequest.product.price }}
									€</p>
							</div>
						</div>

						<hr>

						<div class="row">
							<div class="col-12">
								<p class="mb-1">
									<strong>Request Reference:</strong>
									{{ purchaseOrder.purchaseRequest.reference }}</p>
								<p class="mb-1">
									<strong>Requester:</strong>
									{% if purchaseOrder.purchaseRequest.requester %}
										{# On affiche uniquement le prénom et le nom #}
										{{ purchaseOrder.purchaseRequest.requester.firstname }}
										{{ purchaseOrder.purchaseRequest.requester.lastname }}

										{# Si c'est vide en base, on affiche un petit message d'aide pour vous #}
										{% if purchaseOrder.purchaseRequest.requester.firstname is empty and purchaseOrder.purchaseRequest.requester.lastname is empty %}
											<span class="text-muted small">(No name in database)</span>
										{% endif %}

									{% else %}
										<span class="text-danger">Not assigned</span>
									{% endif %}
								</p>
							</div>
						</div>
					</div>
					<div class="card-footer bg-white">
						<small class="text-muted italic">This purchase order was automatically generated following the approval of the purchase request.</small>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

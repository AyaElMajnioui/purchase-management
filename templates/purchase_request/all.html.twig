{% extends 'base.html.twig' %}

{% block title %}Administration - All Requests
{% endblock %}

{% block body %}
	<div class="container-fluid">
		<div class="card card-outline card-dark shadow">
			<div class="card-header">
				<h3 class="card-title">
					<i class="fas fa-list-ul mr-2"></i>
					Global Purchase Request History
				</h3>
				<div class="card-tools">
					<span class="badge badge-info p-2">Total:
						{{ purchase_requests|length }}</span>
				</div>
			</div>

			<div class="card-body p-0">
				<table class="table table-striped table-hover m-0">
					<thead class="thead-dark">
						<tr>
							<th>Reference</th>
							<th>User</th>
							<th>Product</th>
							<th class="text-center">Qty</th>
							<th class="text-center">Status</th>
							<th>Date</th>
							<th class="text-center">Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for pr in purchase_requests %}
							<tr>
								<td class="font-weight-bold">{{ pr.reference|default('#' ~ pr.id) }}</td>
								<td>
									<span class="text-muted">
										<i class="fas fa-user-circle mr-1"></i>
									</span>
									{{ pr.requester.email }}
								</td>
								<td>
									<span class="badge badge-light border">{{ pr.product.name }}</span>
								</td>
								<td class="text-center font-weight-bold">{{ pr.quantity }}</td>
								<td class="text-center">
									{% if pr.status == 'pending' %}
										<span class="badge badge-warning text-dark shadow-sm">
											<i class="fas fa-hourglass-half mr-1"></i>
											Pending
										</span>

									{% elseif pr.status == 'approved' %}
										<span class="badge badge-success shadow-sm">
											<i class="fas fa-check mr-1"></i>
											Approved
										</span>

									{% elseif pr.status == 'rejected' %}
										<span class="badge badge-danger shadow-sm">
											<i class="fas fa-times mr-1"></i>
											Rejected
										</span>

									{% elseif pr.status == 'draft' %}
										<span class="badge badge-secondary shadow-sm">
											<i class="fas fa-pencil-alt mr-1"></i>
											Draft
										</span>

									{% else %}
										<span class="badge badge-dark shadow-sm">
											{{ pr.status|capitalize }}
										</span>
									{% endif %}
								</td>
								<td class="small text-muted">
									{{ pr.createdAt ? pr.createdAt|date('d/m/Y H:i') : '-' }}
								</td>
								<td class="text-center">
									<a href="{{ path('app_purchase_request_show', {'id': pr.id}) }}" class="btn btn-primary btn-xs shadow-sm" title="Manage this request">
										<i class="fas fa-cog mr-1"></i>
										Manage
									</a>
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="7" class="text-center py-5">
									<img src="https://cdn-icons-png.flaticon.com/512/5058/5058436.png" style="width: 50px; opacity: 0.5;" class="mb-3">
									<p class="text-muted">No requests have been submitted yet.</p>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="card-footer bg-white border-top">
				<div class="row">
					<div class="col-sm-4">
						<small class="text-muted">View reserved for role:
							<strong>ADMIN</strong>
						</small>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

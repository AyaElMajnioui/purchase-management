{% extends 'base.html.twig' %}

{% block title %}Edit Request{% endblock %}

{% block body %}
<div class="container-fluid">
    <div class="row">
        <div class="col-md-10 mx-auto">

            {# Alert if not editable #}
            {% if purchase_request.status != constant('App\\Entity\\PurchaseRequest::STATUS_DRAFT') %}
                <div class="alert alert-warning alert-dismissible shadow-sm">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h5><i class="icon fas fa-exclamation-triangle"></i> Warning!</h5>
                    This request is already <strong>{{ purchase_request.status }}</strong>. Modifying information could affect the validation history.
                </div>
            {% endif %}

            <div class="card card-outline card-warning shadow-sm">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-edit mr-2 text-warning"></i>
                        Edit Request: <strong>{{ purchase_request.reference|default('#' ~ purchase_request.id) }}</strong>
                    </h3>
                    <div class="card-tools">
                        <span class="badge badge-warning">Current Status: {{ purchase_request.status }}</span>
                    </div>
                </div>

                <div class="card-body">
                    <p class="text-muted small mb-4">
                        <i class="fas fa-info-circle mr-1"></i>
                        You can update the quantity or supporting document. If the request is rejected, please create a new request instead of modifying this one.
                    </p>

                    {{ include('purchase_request/_form.html.twig', {'button_label': 'Save Changes'}) }}
                </div>

                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        {# Back Button #}
                        <a href="{{ path('app_purchase_request_index') }}" class="btn btn-outline-secondary btn-sm">
                            <i class="fas fa-arrow-left mr-1"></i> Back to tracking
                        </a>

                        {# Delete Button #}
                        <div>
                            {{ include('purchase_request/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

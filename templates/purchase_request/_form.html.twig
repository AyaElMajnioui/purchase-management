{{ form_start(form) }}
    <div class="row">
        <div class="col-md-8">
            <div class="form-group">
                {{ form_row(form.reference, {
                    'label': 'Reference (Internal)',
                    'attr': {'class': 'form-control', 'placeholder': 'Ex: PR-2025-001'}
                }) }}
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                {{ form_row(form.quantity, {
                    'label': 'Quantity',
                    'attr': {'class': 'form-control', 'min': 1}
                }) }}
            </div>
        </div>
    </div>

    <div class="form-group">
        {{ form_row(form.justification, {
            'label': 'Justification',
            'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Why do you need this?'}
        }) }}
    </div>

    <div class="form-group">
        <label for="{{ form.attachment.vars.id }}">Attachment (PDF)</label>
        <div class="input-group">
            <div class="custom-file">
                {{ form_widget(form.attachment, {'attr': {'class': 'custom-file-input'}}) }}
                <label class="custom-file-label" data-browse="Browse">Choose PDF File</label>
            </div>
        </div>
        {{ form_errors(form.attachment) }}
    </div>

    <div class="mt-4 text-right">
        <button class="btn btn-info px-4 shadow-sm">
            <i class="fas fa-paper-plane mr-1"></i> Submit Request
        </a>
    </div>
{{ form_end(form) }}
